   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "data = {\n",
    "    \"Product\": [\"Laptop\", \"Phone\", \"Tablet\", \"Laptop\", \"Phone\",\n",
    "                \"Tablet\", \"Laptop\", \"Phone\"],\n",
    "    \"Category\": [\"Electronics\", \"Electronics\", \"Electronics\",\n",
    "                 \"Electronics\", \"Electronics\", \"Electronics\",\n",
    "                 \"Electronics\", \"Electronics\"],\n",
    "    \"Price\": [55000, 20000, 15000, 60000, 22000, 14000, 58000, 21000],\n",
    "    \"Quantity\": [2, 5, 3, 1, 4, 6, 2, 3],\n",
    "    \"City\": [\"Amalapuram\", \"Rajahmundry\", \"Kakinada\", \"Amalapuram\",\n",
    "             \"Kakinada\", \"Rajahmundry\", \"Amalapuram\", \"Kakinada\"]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "df[\"Sales\"] = df[\"Price\"] * df[\"Quantity\"]\n",
    "\n",
    "df"
   ]
  },
