    "product_analysis = df.groupby(\"Product\").agg(\n",
    "    Total_Sales=(\"Sales\", \"sum\"),\n",
    "    Average_Sales=(\"Sales\", \"mean\"),\n",
    "    Total_Quantity=(\"Quantity\", \"sum\")\n",
    ")\n",
    "\n",
    "product_analysis"
   ]
