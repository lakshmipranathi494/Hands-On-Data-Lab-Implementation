   "source": [
    "clean_df[\"Age\"] = clean_df[\"Age\"].fillna(\n",
    "    clean_df[\"Age\"].median()\n",
    ")\n",
    "\n",
    "clean_df[\"Salary\"] = clean_df[\"Salary\"].fillna(\n",
    "    clean_df[\"Salary\"].mean()\n",
    ")\n",
    "\n",
    "clean_df"
   ]
  },
